// =============================================================================
// Trade Levels Pro: Daily Levels (Free)
// -----------------------------------------------------------------------------
// A free, self-contained version of the Trade Levels Pro method. It plots the
// daily "magnet" (the price the session gravitates to), a volatility-scaled
// balance zone around it, and the prior day's high, low, and close, so you can
// see the framework the full plan is built on.
//
// The paid daily plan adds the part that matters most: the ranked failed-
// breakdown long entries, the backups, the targets, and the invalidation for
// ES and NQ, printed after the close every trading day.
//   Full ranked plan + free nightly ES levels: https://tradelevelspro.com
//
// HOW TO PUBLISH (Ryan): open TradingView, Pine Editor, paste this, Save, then
// "Publish script" -> Public. Good title: "Trade Levels Pro: Daily Levels
// (Free)". In the description, say what it does and link tradelevelspro.com.
// Open-source is fine here; the ranked-shelf logic stays in the product.
// =============================================================================
//@version=5
indicator("Trade Levels Pro: Daily Levels (Free)", shorttitle="TLP Daily", overlay=true, max_labels_count=20)

// === Inputs ===================================================================
grp        = "Trade Levels Pro"
showZone   = input.bool(true,  "Show balance zone",    group=grp)
showPrior  = input.bool(true,  "Show prior day H/L/C", group=grp)
showLabels = input.bool(true,  "Show labels",          group=grp)
atrMult    = input.float(0.25, "Zone width (x ATR)",   group=grp, step=0.05, minval=0.05, maxval=1.0)

// === Prior-day data (confirmed, non-repainting) ==============================
pdh  = request.security(syminfo.tickerid, "D", high[1],     lookahead=barmerge.lookahead_on)
pdl  = request.security(syminfo.tickerid, "D", low[1],      lookahead=barmerge.lookahead_on)
pdc  = request.security(syminfo.tickerid, "D", close[1],    lookahead=barmerge.lookahead_on)
atrD = request.security(syminfo.tickerid, "D", ta.atr(14),  lookahead=barmerge.lookahead_on)

// === Magnet (floor-trader pivot) and the balance zone ========================
magnet = (pdh + pdl + pdc) / 3.0
dz     = atrMult * atrD
zTop   = magnet + dz
zBot   = magnet - dz

// === Plots (one flat step per day) ===========================================
pMag = plot(magnet, "Magnet", color=color.new(color.orange, 0), linewidth=2, style=plot.style_linebr)
pTop = plot(showZone ? zTop : na, "Zone top",    color=color.new(color.orange, 55), style=plot.style_linebr)
pBot = plot(showZone ? zBot : na, "Zone bottom", color=color.new(color.orange, 55), style=plot.style_linebr)
fill(pTop, pBot, color=showZone ? color.new(color.orange, 92) : na, title="Balance zone")

plot(showPrior ? pdh : na, "Prior day high",  color=color.new(color.red, 30),   style=plot.style_linebr)
plot(showPrior ? pdl : na, "Prior day low",   color=color.new(color.green, 30), style=plot.style_linebr)
plot(showPrior ? pdc : na, "Prior day close", color=color.new(color.gray, 20),  style=plot.style_linebr)

// === Labels on the last bar (delete-and-redraw so they never stack) ==========
var label[] TLP = array.new_label()
addLabel(_p, _txt, _col) =>
    array.push(TLP, label.new(bar_index, _p, _txt, xloc=xloc.bar_index, style=label.style_label_left, color=_col, textcolor=color.white, size=size.small))

if barstate.islast
    while array.size(TLP) > 0
        label.delete(array.pop(TLP))
    if showLabels
        addLabel(magnet, "Magnet " + str.tostring(magnet, format.mintick), color.new(color.orange, 0))
        if showZone
            addLabel(zTop, "Zone top",    color.new(color.orange, 35))
            addLabel(zBot, "Zone bottom", color.new(color.orange, 35))
        if showPrior
            addLabel(pdh, "Prior high",  color.new(color.red, 20))
            addLabel(pdl, "Prior low",   color.new(color.green, 20))
            addLabel(pdc, "Prior close", color.new(color.gray, 10))
